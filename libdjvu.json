{
    "name": "libdjvu",
    "version": "1.0.1",
    "description": "DjVu document decoder",
    "filters":["djvudec"],
    "help": "This filter renders the first page of a DjVu document to a raw image using DjVuLibre.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libdjvu.accessor",
    "filter_source":{
        "djvudec" : "dec_djvu.c"
    },
    "extension":{
      "djvu" : "img",
      "djv" : "img"
    },
    "using": ["solver_1"],
    "patents": {
        "status": "expired",
        "note": "DjVu",
        "checked": "2026-10-16"
    }
}
